{
  "id": "camofox-browser",
  "name": "Camofox Browser",
  "version": "1.14.0",
  "newPageTimeoutMs": 10000,
  "interactive": {
    "mode": "off"
  },
  "plugins": {
    "local-hardening": {
      "enabled": true
    },
    "persistence": {
      "enabled": true,
      "indexedDB": false
    },
    "youtube": {
      "enabled": false
    },
    "vnc": {
      "enabled": false
    },
    "local-storage-checkpoint": {
      "enabled": true
    }
  }
}
